# Chemin de base de l’API côté client. Ne placez jamais de secrets dans les variables VITE_*.
VITE_API_BASE_URL=/api
# Cible du proxy Vite en développement et en aperçu ; absente du code client.
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
# Durée facultative du quiz en secondes (1–86400). Uniquement pour les nouvelles tentatives.
VITE_QUIZ_DURATION_SECONDS=600
