# Client-facing API base path. Never put secrets in VITE_* variables.
VITE_API_BASE_URL=/api
# Vite dev/preview proxy target; not included in the client bundle.
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
# Optional quiz duration in seconds (1–86400). Applies to new attempts only.
VITE_QUIZ_DURATION_SECONDS=600
